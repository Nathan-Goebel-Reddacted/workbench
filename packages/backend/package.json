{
  "name": "@atelier/backend",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --watch src src/index.ts",
    "start": "tsx src/index.ts",
    "mcp": "tsx src/mcp.ts",
    "build": "tsc && tsc-alias -p tsconfig.json --resolve-full-paths",
    "typecheck": "tsc --noEmit"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/shared/infrastructure/mikro-orm.config.ts"
    ]
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.13",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.19.17",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/oauth2": "^8.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@mikro-orm/core": "^6.6.13",
    "@mikro-orm/migrations": "^6.6.13",
    "@mikro-orm/postgresql": "^6.6.13",
    "@mikro-orm/reflection": "^6.6.13",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.8.5",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  }
}
