{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist",
    // Le TsMorphMetadataProvider lit les types au démarrage ; en production il n'y a plus
    // de .ts, il lui faut les déclarations émises à côté du .js.
    "declaration": true,
    "strict": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@contexts/*": ["./src/contexts/*"]
    }
  },
  "include": ["src"],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
