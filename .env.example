# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=atelier
POSTGRES_USER=atelier
POSTGRES_PASSWORD=change_me

# Construite automatiquement à partir des variables ci-dessus
DATABASE_URL=postgresql://atelier:change_me@postgres:5432/atelier

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me

# ── OAuth 2.0 (ADR-008) ───────────────────────────────────────────────────────
# Provider : "github" ou "google"
OAUTH_PROVIDER=github

# GitHub OAuth App : https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth App : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Whitelist accès privé ─────────────────────────────────────────────────────
# Emails séparés par des virgules
ALLOWED_EMAILS=you@example.com
