# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=atelier
POSTGRES_USER=atelier
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Construite automatiquement à partir des variables ci-dessus
DATABASE_URL=postgresql://atelier:change_me@localhost:5432/atelier

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Le serveur refuse de démarrer en dessous de 32 caractères, et sur `change_me` tel quel.
JWT_SECRET=change_me

# Durée de validité du cookie de session (format ms/vercel : 7d, 12h, 30m).
SESSION_TTL=7d

# Le cookie de session est `secure` par défaut : il ne part que sur HTTPS. En
# développement local, où le backend est en http://, il faut lever cette exigence —
# sinon aucune session ne s'établit. À laisser vide ou à 'false' partout ailleurs :
# la mettre à 'true' derrière un domaine public expose la session en clair.
ALLOW_INSECURE_COOKIE=true

# ── Amorçage du premier administrateur ────────────────────────────────────────
# Sur une base vierge la whitelist est vide : aucune connexion OAuth n'aboutit, et la
# route qui ajoute une adresse exige déjà le rôle 'edit'. Cette variable est la seule
# porte d'entrée. Elle est relue à chaque démarrage et n'enlève jamais rien :
#   - l'adresse est ajoutée à la whitelist si elle en est absente
#   - le rôle 'edit' lui est accordé, à la création du compte ou au démarrage suivant
# Peut être laissée vide une fois le premier administrateur en place.
BOOTSTRAP_ADMIN_EMAIL=

# ── OAuth 2.0 (ADR-008) ───────────────────────────────────────────────────────
# Un fournisseur n'est branché que si SES DEUX variables sont renseignées : sinon ni son
# bouton de connexion, ni ses routes n'existent, et un avertissement le dit au démarrage.
# Il en faut au moins un complet — sans quoi le serveur refuse de démarrer, plutôt que de
# servir un espace privé sans aucune porte d'entrée.
#
# GitHub OAuth App — https://github.com/settings/developers > New OAuth App
# Callback URL : http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth App — https://console.cloud.google.com/apis/credentials > Create OAuth client
# Callback URL : http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── URLs ──────────────────────────────────────────────────────────────────────
# En développement les trois briques ont chacune leur port.
APP_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:5173
FRONTEND_PRIVATE_URL=http://localhost:5174

# En production tout passe par le nginx de docker-compose.prod.yml, sous une origine
# unique : / = site public, /admin/ = espace privé, /api/ = backend. Remplacer les
# quatre lignes ci-dessus par (PUBLIC_ORIGIN étant le domaine réel) :
#   APP_URL=https://domaine.tld/api
#   FRONTEND_PUBLIC_URL=https://domaine.tld
#   FRONTEND_PRIVATE_URL=https://domaine.tld/admin
#   VITE_API_URL=https://domaine.tld/api
#   VITE_PUBLIC_URL=https://domaine.tld
# Les URLs de callback OAuth doivent alors pointer sur ${APP_URL}/auth/<provider>/callback.

# Port publié par le nginx de production sur l'hôte.
WEB_PORT=8080

# ── Exploitation ──────────────────────────────────────────────────────────────
# Écoute du backend. En production nginx l'atteint par le réseau compose ; le port
# n'est pas publié sur l'hôte.
PORT=3000
HOST=0.0.0.0

# Niveau pino : trace, debug, info, warn, error, fatal. Les logs sortent en JSON sur
# stdout — c'est au collecteur de décider où ils vont, pas à l'application.
LOG_LEVEL=info

# ── Formulaire de contact (SMTP) ──────────────────────────────────────────────
# Adresse qui reçoit les messages du widget « Formulaire ». Si elle est vide, les
# messages sont quand même enregistrés en base, mais aucun mail ne part.
CONTACT_MAIL_TO=

# Gmail : créer un mot de passe d'application (compte Google > Sécurité >
# Validation en deux étapes > Mots de passe des applications) — le mot de passe
# du compte ne fonctionne pas. Sans ces variables, les mails sont affichés dans
# la console au lieu d'être envoyés.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché ; par défaut SMTP_USER. L'adresse du visiteur va en Reply-To.
SMTP_FROM=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Figées dans le bundle au moment du build : changer une de ces valeurs impose de
# reconstruire l'image web.
VITE_API_URL=http://localhost:3000
# Utilisée par content-renderer/SectionPreview.tsx pour fabriquer les liens vers le
# site public depuis l'aperçu de l'éditeur.
VITE_PUBLIC_URL=http://localhost:5173
